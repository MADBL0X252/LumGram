{
  "name": "LumGram",
  "description": "Instagram themes with independent site, navigation and per-chat backgrounds/opacity, eight fonts, and subtle animations.",
  "version": "1.3.3",
  "manifest_version": 3,
  "icons": {
    "16": "assets/img/lumgram-16.png",
    "48": "assets/img/lumgram-48.png",
    "128": "assets/img/lumgram-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "exclude_matches": [
        "https://*/accounts/login/*",
        "https://*/accounts/signup/*",
        "https://*/accounts/password/*",
        "https://*/challenge/*",
        "https://*/oauth/*"
      ],
      "js": [
        "font-manager.js",
        "themes.js",
        "scope-model.js",
        "background-image.js",
        "panel-opacity.js",
        "instagram-adapter.js",
        "main.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*.svg",
        "assets/fonts/*.ttf"
      ],
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self';"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Open LumGram dashboard"
    },
    "toggle-extension": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle LumGram on/off"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "dashboard.html",
    "default_icon": {
      "16": "assets/img/lumgram-16.png",
      "48": "assets/img/lumgram-48.png",
      "128": "assets/img/lumgram-128.png"
    },
    "default_title": "LumGram"
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ]
}
